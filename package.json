{
  "name": "blgasm-grocery-pos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "npm run build && node electron/prepare-standalone.cjs && electron-builder --win nsis --x64",
    "desktop:dir": "npm run build && node electron/prepare-standalone.cjs && electron-builder --win dir --x64",
    "electron": "electron .",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.12.79",
    "@zxing/browser": "^0.2.0",
    "firebase": "^12.14.0",
    "idb": "^8.0.3",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.6",
    "electron": "^35.7.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.blgasm.pos",
    "productName": "Blgasm POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Blgasm-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blgasm POS"
    }
  }
}
