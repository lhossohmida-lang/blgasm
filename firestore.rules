rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // storeId is always equal to the owner's Firebase uid
    function isOwner(storeId) {
      return request.auth != null && request.auth.uid == storeId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /stores/{storeId} {
      allow read, write: if isOwner(storeId);

      match /products/{productId} {
        allow read, write: if isOwner(storeId);
      }

      match /sales/{saleId} {
        allow read, write: if isOwner(storeId);
      }

      match /creditCustomers/{customerId} {
        allow read, write: if isOwner(storeId);

        match /transactions/{transactionId} {
          allow read, write: if isOwner(storeId);
        }
      }

      match /creditTransactions/{transactionId} {
        allow read, write: if isOwner(storeId);
      }

      match /syncQueue/{operationId} {
        allow read, write: if isOwner(storeId);
      }
    }
  }
}
