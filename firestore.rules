rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // storeId equals the owner's uid (primary case)
    // OR the store document's ownerId field matches the requester
    function isOwner(storeId) {
      return signedIn() && (
        request.auth.uid == storeId
        || (
          exists(/databases/$(database)/documents/stores/$(storeId))
          && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid
        )
      );
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /stores/{storeId} {
      allow create: if signedIn() && (
        request.auth.uid == storeId
        || request.resource.data.ownerId == request.auth.uid
      );
      allow read, update, delete: if isOwner(storeId);

      match /products/{productId} {
        allow read, write: if isOwner(storeId);
      }
      match /sales/{saleId} {
        allow read, write: if isOwner(storeId);
      }
      match /creditCustomers/{customerId} {
        allow read, write: if isOwner(storeId);
        match /transactions/{transactionId} {
          allow read, write: if isOwner(storeId);
        }
      }
      match /creditTransactions/{transactionId} {
        allow read, write: if isOwner(storeId);
      }
      match /syncQueue/{operationId} {
        allow read, write: if isOwner(storeId);
      }
    }
  }
}
