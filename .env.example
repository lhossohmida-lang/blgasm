# مفتاح OpenRouter — يُضبط على Vercel كمتغير بيئة سرّي، لا يُرسل للمتصفح.
# Vercel → Project → Settings → Environment Variables → Add → OPENROUTER_API_KEY
OPENROUTER_API_KEY=sk-or-v1-...

# (اختياري) قائمة بالنطاقات المسموح لها بمناداة /api/chat، مفصولة بفواصل.
# الافتراضي "*" يسمح من أي نطاق. للأمان أضف نطاقك مثل https://your-app.vercel.app
ALLOWED_ORIGINS=*

# (اختياري — للتطوير المحلي فقط) عنوان الـ API إذا كان مختلفاً عن نفس النطاق
# مثلاً لتشغيل npm run dev محلياً مع الإشارة إلى نشر Vercel بعيد
# VITE_AI_API_BASE=https://your-app.vercel.app
