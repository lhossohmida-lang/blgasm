# مفتاح OpenRouter — يُضبط على Vercel كمتغير بيئة سرّي، لا يُرسل للمتصفح.
# Vercel → Project → Settings → Environment Variables → Add → OPENROUTER_API_KEY
OPENROUTER_API_KEY=sk-or-v1-...

# (اختياري) قائمة بالنطاقات المسموح لها بمناداة /api/chat، مفصولة بفواصل.
# الافتراضي "*" يسمح من أي نطاق. للأمان أضف نطاقك مثل https://your-app.vercel.app
ALLOWED_ORIGINS=*

# (اختياري — للتطوير المحلي فقط) عنوان الـ API إذا كان مختلفاً عن نفس النطاق
# VITE_AI_API_BASE=https://your-app.vercel.app

# ──────────────────────────────────────────────────────────────
# Cloudinary — رفع صور المنتجات (بديل Firebase Storage)
# ──────────────────────────────────────────────────────────────
# 1. أنشئ حساباً مجانياً على https://cloudinary.com
# 2. من لوحة التحكم → Settings → Upload → Add upload preset
#    — اختر "Unsigned" كـ Signing Mode
#    — أضف مجلداً اسمه "products" (اختياري)
# 3. انسخ Cloud Name و Upload Preset هنا:
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ──────────────────────────────────────────────────────────────
# ملاحظة: VITE_ متغيرات تُرسل للمتصفح — لا تضع فيها مفاتيح سرية.
# Cloudinary unsigned preset آمن للاستخدام من المتصفح مباشرة.
# ──────────────────────────────────────────────────────────────
